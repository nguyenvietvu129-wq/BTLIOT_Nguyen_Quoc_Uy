{
  "info": {
    "_postman_id": "204c768d-6772-4fbf-b055-67b35294fd9b",
    "name": "IoT Monitoring API",
    "description": "Chạy Login trước. Postman tự giữ cookie JSESSIONID. API ingest không yêu cầu đăng nhập.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login thành công', () => pm.response.to.have.status(200));"] } }]
        },
        { "name": "Current user", "request": { "method": "GET", "url": "{{baseUrl}}/api/me" } },
        { "name": "Logout", "request": { "method": "POST", "url": "{{baseUrl}}/api/logout" } }
      ]
    },
    {
      "name": "2. Catalog",
      "item": [
        { "name": "List sensors", "request": { "method": "GET", "url": "{{baseUrl}}/api/sensors" } },
        {
          "name": "List devices",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/devices" },
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.length) pm.environment.set('deviceId', data[0].id);"] } }]
        }
      ]
    },
    {
      "name": "3. Sensor data",
      "item": [
        {
          "name": "Ingest ESP32 payload (public)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"temperature\": 28.5,\n  \"humidity\": 65.2,\n  \"light\": 420\n}" },
            "url": "{{baseUrl}}/api/datasensors/ingest"
          }
        },
        { "name": "List sensor data", "request": { "method": "GET", "url": "{{baseUrl}}/api/datasensors?page=1&limit=20&sortKey=measuredAt&sortDir=DESC" } },
        { "name": "Search sensor data", "request": { "method": "GET", "url": "{{baseUrl}}/api/datasensors/search?sensorName=nhiệt&measuredAt=&value=&page=1&limit=20" } },
        { "name": "Dashboard summary", "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/summary" } }
      ]
    },
    {
      "name": "4. Device commands",
      "item": [
        {
          "name": "Turn device ON",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"state\": \"ON\" }" },
            "url": "{{baseUrl}}/api/devices/{{deviceId}}/state"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Command accepted', () => pm.response.to.have.status(202));", "const data = pm.response.json();", "if (data.historyId) pm.environment.set('historyId', data.historyId);"] } }]
        },
        { "name": "Poll command result", "request": { "method": "GET", "url": "{{baseUrl}}/api/activehistories/{{historyId}}" } },
        { "name": "List command history", "request": { "method": "GET", "url": "{{baseUrl}}/api/activehistories?page=1&limit=20" } },
        { "name": "Search command history", "request": { "method": "GET", "url": "{{baseUrl}}/api/activehistories/search?action=ON&status=&page=1&limit=20" } }
      ]
    }
  ]
}
